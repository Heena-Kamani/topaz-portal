<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @quote.title %> | Topaz Design Co.</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%# same-origin keeps the private link out of other sites, while letting the accept form prove it came from here %>
    <meta name="referrer" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= render "shared/fonts" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="client">
    <main class="paper">
      <header class="letterhead">
        <span class="wordmark">Topaz Design Co.</span>
        <span class="soft">Design and consulting, Edmonton</span>
      </header>

      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
